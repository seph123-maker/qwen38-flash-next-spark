[Unit]
Description=Flare local inference server (qwen3.8-flash-next)
Documentation=https://github.com/local-inference-lab/flare-local-inference
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0
StartLimitBurst=0

[Service]
Type=simple
User=root
WorkingDirectory=/root
ExecStart=/usr/local/bin/flare-current run /usr/local/share/flare-package-current --host 0.0.0.0 --port 8000 --served-model-name qwen3.8-flash-next --verify-weights --embedding-table-storage disk --embedding-table-cache-size 1GiB
Restart=always
RestartSec=10
TimeoutStartSec=300
StandardOutput=append:/root/flare-live.log
StandardError=append:/root/flare-live.log

[Install]
WantedBy=multi-user.target
